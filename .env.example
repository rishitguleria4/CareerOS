# Local: leave DATABASE_URL empty to use the embedded database (frontend/.data).
# Production (Vercel + Neon): DATABASE_URL is added automatically by the Neon integration.
DATABASE_URL=

# Optional: enables AI resume parsing, tailoring, cover notes and outreach drafts.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Required on Vercel (the app refuses to serve without it). Optional locally.
APP_PASSWORD=

# Required on Vercel: authorises the daily discovery cron.
CRON_SECRET=

